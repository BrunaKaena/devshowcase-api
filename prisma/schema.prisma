generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  bio       String?
  projects  Project[]
}

model Project {
  id            Int          @id @default(autoincrement())
  title         String
  description   String?
  repositoryUrl String
  profileId     Int

  profile       Profile      @relation(fields: [profileId], references: [id])
  technologies  Technology[]
  feedbacks     Feedback[]
}

model Technology {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  projects Project[]
}

model Feedback {
  id        Int      @id @default(autoincrement())
  comment   String
  author    String
  projectId Int

  project   Project  @relation(fields: [projectId], references: [id])
}